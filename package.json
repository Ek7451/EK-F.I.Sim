{
  "name": "ek-fi-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fisim/web dev",
    "build": "pnpm --filter @fisim/web build",
    "preview": "pnpm --filter @fisim/web preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:validation": "vitest run --project validation",
    "validate:data": "tsx packages/data/scripts/validate.ts",
    "bench": "tsx packages/engine/bench/bench.ts",
    "e2e": "pnpm --filter @fisim/e2e test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^3.23.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
